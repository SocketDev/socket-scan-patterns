{
  "name": "@socketsecurity/scan-patterns",
  "version": "0.0.0",
  "description": "Canonical detector pattern tables for Socket's baseline security scanners",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*.json": "./data/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "data",
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen": "node scripts/gen/all.mts",
    "check:coverage-oracle": "node scripts/check/trufflehog-coverage.mts",
    "check:data-drift": "node scripts/check/data-is-regenerated.mts"
  }
}
